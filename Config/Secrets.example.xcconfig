// Copy this file to Config/Secrets.xcconfig (gitignored) and paste your own keys.
// Never commit a real key. Never use the Parse Master Key or JavaScript Key in the app.

// OpenAlex (paper search): https://openalex.org/settings/api
OPENALEX_API_KEY = YOUR_OPENALEX_API_KEY

// Google Gemini (Ask about this paper): https://aistudio.google.com/apikey
GEMINI_API_KEY = YOUR_GEMINI_API_KEY

// Back4App: App Settings > Security & Keys. NEVER use the Master Key or JavaScript Key.
PARSE_APPLICATION_ID = YOUR_PARSE_APPLICATION_ID
PARSE_REST_API_KEY = YOUR_PARSE_REST_API_KEY
