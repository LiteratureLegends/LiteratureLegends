// App.xcconfig: base build settings for the LiteratureLegends app target (Debug and Release).
// Nothing in this file is secret. Real keys go in the gitignored Config/Secrets.xcconfig.

// Custom Info.plist keys, merged with the generated plist (GENERATE_INFOPLIST_FILE = YES).
// It lives outside the synchronized LiteratureLegends/ folder, so it is never copied as a resource.
INFOPLIST_FILE = Config/Info.plist

// Debug only: lets LiteratureLegendsTests use `@testable import` (Xcode's template default).
ENABLE_TESTABILITY[config=Debug] = YES
ONLY_ACTIVE_ARCH[config=Debug] = YES

// Public, non-secret settings. In xcconfig files "//" starts a comment, hence the "/$()/" trick.
PARSE_SERVER_URL = https:/$()/parseapi.back4app.com
GEMINI_MODEL = gemini-3.5-flash-lite

// Empty defaults so the app builds without secrets; it then shows setup messages instead of crashing.
OPENALEX_API_KEY =
GEMINI_API_KEY =
PARSE_APPLICATION_ID =
PARSE_REST_API_KEY =

// Local, gitignored secrets override the defaults above. `#include?` means the file is optional.
#include? "Secrets.xcconfig"
